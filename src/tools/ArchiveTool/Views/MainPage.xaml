<Page
    x:Class="ArchiveTool.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:ArchiveTool.ValueConverters"
    xmlns:convertersWinUI="using:ArchiveTool.ValueConverters.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ArchiveTool.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ArchiveTool.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />-->
                <ResourceDictionary>
                    <converters:ExplorerItemTypeToIconUriValueConverter x:Key="TypeToIconConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar>
            <MenuBar.Items>
                <MenuBarItem Title="File">
                    <MenuBarItem.Items>
                        <MenuFlyoutItem Icon="NewFolder" Text="New">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem Icon="OpenFile" Text="Open...">
                            <MenuFlyoutSubItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutSubItem.KeyboardAccelerators>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.OpenFolderCommand}" Text="Open Folder" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.OpenArchiveCommand}" Text="Open Archive" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Icon="Save" Text="Save">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Exit">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem.Items>
                </MenuBarItem>

                <MenuBarItem Title="Edit">
                    <MenuBarItem.Items>
                        <MenuFlyoutItem Icon="Undo" Text="Undo" />
                        <MenuFlyoutItem Icon="Redo" Text="Redo" />
                        <MenuFlyoutItem Icon="Copy" Text="Copy">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Icon="Paste" Text="Paste">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Icon="Cut" Text="Cut">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="X" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Icon="Delete" Text="Delete" />
                    </MenuBarItem.Items>
                </MenuBarItem>

                <MenuBarItem Title="Tools">
                    <MenuBarItem.Items>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.PackFolderCommand}" Text="Pack Folder" />
                    </MenuBarItem.Items>
                </MenuBarItem>

                <MenuBarItem Title="Help">
                    <MenuBarItem.Items>
                        <MenuFlyoutItem Icon="Help" Text="About" />
                    </MenuBarItem.Items>
                </MenuBarItem>
            </MenuBar.Items>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>


            <StackPanel Orientation="Horizontal">
                <CommandBar Background="Transparent" OverflowButtonVisibility="Collapsed">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Icon="Previous"
                            KeyboardAcceleratorPlacementMode="Auto">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarButton
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Icon="Next"
                            KeyboardAcceleratorPlacementMode="Auto">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Icon="Refresh"
                            KeyboardAcceleratorPlacementMode="Auto">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarButton
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.NavigateToParentCommand}"
                            Icon="Up"
                            KeyboardAcceleratorPlacementMode="Auto">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>

                </CommandBar>

            </StackPanel>

            <!--  BreadcrumbBar  -->
            <BreadcrumbBar
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Breadcrumbs}">
                <Interactivity:Interaction.Behaviors>
                    <Interactivity:EventTriggerBehavior EventName="ItemClicked">
                        <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.BreadcrumbBarItemClickedCommand}" InputConverter="{StaticResource WinUIControlEventArgsConverter}" />
                    </Interactivity:EventTriggerBehavior>
                </Interactivity:Interaction.Behaviors>

                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbItemViewModel">
                        <TextBlock Text="{x:Bind Name}">
                            <TextBlock.ContextFlyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ListView
                                        CanReorderItems="False"
                                        IsItemClickEnabled="True"
                                        ItemsSource="{x:Bind Children}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                                        ScrollViewer.VerticalScrollMode="Enabled"
                                        SelectionMode="None">
                                        <!--  ItemClick="{x:Bind ItemClickEventHandler}"  -->

                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BreadcrumbItemViewModel">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{x:Bind ItemType, Converter={StaticResource TypeToIconConverter}}" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        FontSize="12"
                                                        Text="{x:Bind Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" IsChecked="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}">
                    <ToggleButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Edit Mode" />
                            <FontIcon Margin="4,0,0,0" Glyph="&#xE783;" />
                        </StackPanel>
                    </ToggleButton.Content>
                </ToggleButton>

                <AutoSuggestBox
                    x:Name="autoSuggestBox"
                    Grid.Column="1"
                    Margin="8"
                    PlaceholderText="Search"
                    QueryIcon="Find">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>

                    <Interactivity:Interaction.Behaviors>
                        <Interactivity:EventTriggerBehavior EventName="TextChanged">
                            <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.ChildrenDetailsViewModel.SearchCommand, Mode=OneWay}" CommandParameter="{Binding Path=Text, ElementName=autoSuggestBox}" />
                        </Interactivity:EventTriggerBehavior>

                        <Interactivity:EventTriggerBehavior EventName="QuerySubmitted">
                            <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.AutoSuggestBoxQuerySubmittedCommand}" InputConverter="{StaticResource WinUIControlEventArgsConverter}" />
                        </Interactivity:EventTriggerBehavior>
                    </Interactivity:Interaction.Behaviors>

                </AutoSuggestBox>
            </Grid>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="1*"
                    MinWidth="200"
                    MaxWidth="400" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <TreeView
                Grid.Column="0"
                AllowDrop="False"
                CanDragItems="False"
                ItemsSource="{x:Bind ViewModel.TreeViewItems, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTreeViewItem, Mode=OneWay}"
                SelectionMode="Single">

                <Interactivity:Interaction.Behaviors>
                    <Interactivity:EventTriggerBehavior EventName="ItemInvoked">
                        <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.TreeViewItemInvokedCommand}" InputConverter="{StaticResource WinUIControlEventArgsConverter}" />
                    </Interactivity:EventTriggerBehavior>

                    <Interactivity:EventTriggerBehavior EventName="Collapsed">
                        <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.TreeViewCollapsedCommand}" InputConverter="{StaticResource WinUIControlEventArgsConverter}" />
                    </Interactivity:EventTriggerBehavior>

                    <Interactivity:EventTriggerBehavior EventName="Expanding">
                        <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.TreeViewExpandingCommand}" InputConverter="{StaticResource WinUIControlEventArgsConverter}" />
                    </Interactivity:EventTriggerBehavior>

                </Interactivity:Interaction.Behaviors>

                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeViewItemViewModel">
                        <TreeViewItem
                            HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                            ItemsSource="{x:Bind Children, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <Image Margin="0,0,4,0" Source="{x:Bind ItemType, Converter={StaticResource TypeToIconConverter}}" />
                                <TextBlock
                                    Margin="0,2"
                                    FontSize="12"
                                    Text="{x:Bind Name}" />
                            </StackPanel>
                            <TreeViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind ItemType}" />
                                </MenuFlyout>
                            </TreeViewItem.ContextFlyout>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>

            </TreeView>

            <local:ContainerDetailsControl Grid.Column="2" DataContext="{x:Bind ViewModel.ChildrenDetailsViewModel, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
