                                                                   Visibility="{x:Bind CanExtract}">
                                                    <MenuFlyoutItem Text="Top Level Only"
                                                        Command="{x:Bind ExtractCommand}" />
                                                    <MenuFlyoutItem Text="Extract Nested Archives"
                                                        Command="{x:Bind ExtractRecursiveCommand}" />
